# MongoDB Atlas connection string (Network Access: 0.0.0.0/0 for Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/timber-glow

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Local dev port
PORT=3000

# Used by `npm run seed` to read the storefront's dummy data
FRONT_MOCKS_DIR=../timber-glow-react/src/mocks/data

# Admin login. Generate the hash with: npm run hash-password -- "your-password"
# JWT_SECRET: any long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional. Not needed when the store proxies /api (the default setup), only if the
# store calls the API directly on another subdomain: COOKIE_DOMAIN=.yourdomain.com
COOKIE_DOMAIN=

# Image uploads (Cloudinary → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
